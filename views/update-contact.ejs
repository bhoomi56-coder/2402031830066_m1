<!DOCTYPE html>
<html>
<head>
    <title>Update Contact</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h2>Update Contact</h2>

    <form method="POST" action="/update-contact/<%= contact._id %>">

        <input
            type="text"
            name="first_name"
            value="<%= contact.first_name %>"
            class="form-control mb-3"
            required
        >

        <input
            type="text"
            name="last_name"
            value="<%= contact.last_name %>"
            class="form-control mb-3"
            required
        >

        <input
            type="email"
            name="email"
            value="<%= contact.email %>"
            class="form-control mb-3"
            required
        >

        <input
            type="text"
            name="phone"
            value="<%= contact.phone %>"
            class="form-control mb-3"
            required
        >

        <button class="btn btn-warning">
            Update Contact
        </button>

        <a href="/" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>

</body>
</html>